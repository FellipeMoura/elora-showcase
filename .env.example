# Application
NODE_ENV=development
APP_VERSION=
CORE_PORT=5501
CHAT_PORT=5502

# Logs: false = one-liner por request (default). true = payload completo
# (headers, query, params, etc.) — útil pra debugging fundo.
LOG_VERBOSE=false

# Database (Postgres)
# DATABASE_USER é admin (superuser) — usado SÓ por migrations e seed.
# DATABASE_APP_USER é o role da aplicação (no-bypassrls), usado por core/chat.
# Separação é o que faz RLS funcionar — sem ela, superuser bypassa toda isolação.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=elora
DATABASE_PASSWORD=elora
DATABASE_APP_USER=elora_app
DATABASE_APP_PASSWORD=elora_app
DATABASE_NAME=elora_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO — storage de mídia. Em dev, o container `elora_minio` do compose;
# em prod, troca pra S3 mantendo a mesma interface no app.
#
# OPERAÇÕES SERVER-SIDE (app rodando no host):
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=elora
MINIO_SECRET_KEY=eloraminio
MINIO_BUCKET=elora
# Bucket dedicado pra mídia de WhatsApp (fotos, áudios, vídeos, docs,
# stickers, foto de perfil). Criado on-demand pelo app na primeira vez.
MINIO_WHATSAPP_MEDIA_BUCKET=whatsapp-media
# TTL do presigned URL devolvido pro frontend baixar mídia (segundos).
# 7 dias = 604800. Suficiente pra cachear no browser sem re-pedir a cada view.
MINIO_PRESIGNED_TTL_SEC=604800
#
# PRESIGNED URLS — dois hosts:
#  - MINIO_PUBLIC_*: o que o BROWSER do staff abre (foto, mídia recebida).
#    Dev: localhost. Prod: hostname público do S3/MinIO.
#  - MINIO_PROVIDER_*: o que o EVOLUTION (container) baixa no envio de mídia.
#    Dev: host.docker.internal (localhost dentro do container é o próprio
#    container). Prod: deixar vazio — cai no público.
# Cada um cai no anterior quando ausente (PROVIDER → PUBLIC → MINIO_ENDPOINT).
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
MINIO_PROVIDER_ENDPOINT=host.docker.internal
MINIO_PROVIDER_PORT=9000
MINIO_PROVIDER_USE_SSL=false
# Região fixa nos clientes MinIO (presign sem chamada de rede).
# MINIO_REGION=us-east-1

# Web Push (notificações do chat). Gerar UMA vez por ambiente com
# `npx web-push generate-vapid-keys` e nunca trocar: o par novo invalida
# todas as assinaturas (usuários teriam que reativar). Vazio = push
# desligado (endpoints respondem 501, nada é enviado).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@example.com

# CORS (core e chat): domínio do produto + subdomínios de tenant via HTTPS.
# Em dev, *.localhost em qualquer porta é liberado. Origens extras exatas
# separadas por vírgula (staging, ferramenta interna).
# APP_DOMAIN=elora.app.br
# CORS_EXTRA_ORIGINS=

# JWT
JWT_SECRET=mude-isto-em-producao-pelo-amor-de-deus
JWT_EXPIRES_IN=7d

# Auth interna entre core <-> chat (header X-Internal-Auth).
INTERNAL_API_SECRET=mude-isto-em-producao-tambem

# URLs internas (core chama chat e vice-versa)
CORE_INTERNAL_URL=http://localhost:5501
CHAT_INTERNAL_URL=http://localhost:5502

# Sentry (opcional em dev — deixe vazio se não tiver projeto Sentry ainda)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Evolution API — gateway WhatsApp (ver arquitetura.md §7).
#
# WHATSAPP_WEBHOOK_BASE_URL é a URL BASE que o Evolution chama de volta com
# eventos. Tem que ser acessível DE DENTRO do container Evolution.
# IMPORTANTE: NÃO incluir `/webhook` no final — o EvolutionAdmin appenda
# `/webhook/whatsapp/{channelId}` na URL final. Se você colocar
# `.../chat/webhook`, o path vai duplicar (.../chat/webhook/webhook/...) e o
# Evolution vai bater numa rota que não existe (401 Token inválido). Prod
# típico: `https://<slug>.<dominio>/chat` (nginx faz strip do /chat).
# Aprendizado tirado do primeiro deploy prod do Quartzo (irmão do Elora).
EVOLUTION_API_KEY=dev-evolution-master-key-change-me
EVOLUTION_BASE_URL=http://localhost:5503
EVOLUTION_SERVER_URL=http://localhost:5503
WHATSAPP_WEBHOOK_BASE_URL=http://host.docker.internal:5502

# ZapSign — assinatura eletrônica (módulo contracts). Conta única da Elora
# servindo todos os tenants (até virar dor que justifique conta por tenant).
# Token: ZapSign painel → Configurações → Integrações → API ZapSign → "Renovar Token".
# NUNCA commite o valor real — segredos em chat/print = comprometidos = rotacionar.
ZAPSIGN_API_TOKEN=
# Base URL define o ambiente — sandbox e produção são SUBDOMÍNIOS diferentes,
# NÃO há flag de body. Em dev, use sandbox (gratuito, sem validade jurídica):
#   ZAPSIGN_API_BASE_URL=https://sandbox.api.zapsign.com.br/api/v1
# Em prod, contrate Plano de API ZapSign e mude pra:
#   ZAPSIGN_API_BASE_URL=https://api.zapsign.com.br/api/v1
# Default = produção pra não passar despercebido em deploy.
# IMPORTANTE: templates cadastrados em uma conta NÃO existem na outra. Crie/recadastre
# em sandbox.app.zapsign.com.br pra testar localmente.
ZAPSIGN_API_BASE_URL=https://api.zapsign.com.br/api/v1
# Secret pra validar webhook (a gente gera, não vem da ZapSign).
# Sugestão: openssl rand -hex 32. Cadastrar a URL+token no painel → Webhooks.
# Em prod, configurar o webhook em painel.zapsign.com.br → Webhooks pra bater em
# https://api.elora.app.br/webhooks/zapsign com header X-Elora-Webhook-Token=<este valor>.
ZAPSIGN_WEBHOOK_TOKEN=

# Bucket pra PDFs assinados (R2 em prod, MinIO opt-in em dev). Reusa
# MINIO_ENDPOINT/PORT/USE_SSL/ACCESS_KEY/SECRET_KEY (definidos acima pro chat).
# Quando MINIO_ACCESS_KEY ausente, persistência é skip — webhook ainda atualiza
# status, e download de PDF assinado degrade pra baixar do ZapSign on-demand.
CONTRACTS_BUCKET=contracts
# TTL do presigned GET em segundos (não usado hoje — backend serve o PDF direto).
CONTRACTS_PRESIGNED_TTL_SEC=3600

# Bucket guarda-chuva pra mídia genérica do core — logo do tenant hoje, e
# attachments polimórficos (imagens de orçamento, fotos, docs) no futuro.
# Prefixo por domínio no objectKey (`tenants/{tenantId}/logo{ext}` etc.)
# mantém organização sem multiplicar buckets.
MEDIA_BUCKET=elora-media
# TTL do presigned GET pra mídia (segundos). 1h cobre uma sessão de UI;
# além disso, frontend re-consulta o endpoint.
MEDIA_PRESIGNED_TTL_SEC=3600
