# Template de variaveis pra PRODUCAO.
#
# COMO USAR:
# 1. Copia esse arquivo pra `/srv/elora/.env.production` (FORA do repo, ou
#    se for dentro, lembra que .env* esta no .gitignore — NUNCA commitar com
#    segredos preenchidos).
# 2. Substitui todos os "GERAR_..." por valores reais.
# 3. Pra gerar senhas/secrets fortes:
#       openssl rand -base64 32         # senhas (32 bytes = 256 bits)
#       openssl rand -hex 32            # JWT_SECRET / INTERNAL_API_SECRET
#
# Usar com docker compose:
#   docker compose --env-file ../.env.production \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d

# Aplicacao
NODE_ENV=production
APP_VERSION=
CORE_PORT=5501
CHAT_PORT=5502

# Logs (false = one-liner por request; true = payload completo para debug)
LOG_VERBOSE=false

# Postgres (apps conectam via 127.0.0.1 — Postgres so binda em localhost)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
# Role admin (migrations + seed only). Container Postgres cria como SUPERUSER.
DATABASE_USER=elora
DATABASE_PASSWORD=GERAR_SENHA_FORTE_AQUI
# Role da aplicacao (no-superuser, no-bypassrls). Criado pelo postgres-init.sql
# com senha hardcoded 'elora_app'. APOS PRIMEIRO START, rodar:
#   docker exec -i elora_postgres psql -U elora -d elora_prod -c \
#     "ALTER ROLE elora_app WITH PASSWORD 'NOVA_SENHA_FORTE';"
# E setar DATABASE_APP_PASSWORD aqui com a mesma senha.
DATABASE_APP_USER=elora_app
DATABASE_APP_PASSWORD=GERAR_SENHA_FORTE_AQUI
DATABASE_NAME=elora_prod

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# MinIO (storage de midia — sera migrado pra Cloudflare R2 na Fase 10)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=elora
MINIO_SECRET_KEY=GERAR_SENHA_FORTE_AQUI
MINIO_BUCKET=elora
MINIO_WHATSAPP_MEDIA_BUCKET=whatsapp-media
MINIO_PRESIGNED_TTL_SEC=604800

# MinIO publico (presigned URLs consumidas por browser do staff E pelo Evolution
# dentro do container). Em prod tem que ser hostname publico HTTPS atras do Nginx.
MINIO_PUBLIC_ENDPOINT=minio.elora.app.br
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true

# JWT (gerar com `openssl rand -hex 32` — minimo 256 bits)
JWT_SECRET=GERAR_SECRET_HEX_32_AQUI
JWT_EXPIRES_IN=7d

# Cookie domain — '.elora.app.br' (com ponto) faz cookie de auth viajar entre
# subdominios (frontend em main.elora.app.br + backend em api.elora.app.br).
# Em dev local NAO setar — cookie fica scoped no host (same-origin).
COOKIE_DOMAIN=.elora.app.br

# Auth interna entre core <-> chat
INTERNAL_API_SECRET=GERAR_SECRET_HEX_32_AQUI

# URLs internas (apps Node rodando bare-metal no host, comunicam via localhost)
CORE_INTERNAL_URL=http://127.0.0.1:5501
CHAT_INTERNAL_URL=http://127.0.0.1:5502

# Sentry (DSN do projeto criado em sentry.io)
SENTRY_DSN=GERAR_NO_SENTRY
SENTRY_TRACES_SAMPLE_RATE=0.1

# Evolution API (gateway WhatsApp)
EVOLUTION_API_KEY=GERAR_SENHA_FORTE_AQUI
# URL interna que core/chat usam pra falar com Evolution (localhost no host).
EVOLUTION_BASE_URL=http://127.0.0.1:5503
# URL publica HTTPS (Evolution usa pra montar links em respostas API — QR, media).
EVOLUTION_SERVER_URL=https://evolution.elora.app.br
# Webhook do Evolution callback pro apps/chat. Publico HTTPS atras do Nginx.
WHATSAPP_WEBHOOK_BASE_URL=https://chat.elora.app.br
