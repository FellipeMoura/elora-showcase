# Em dev, o frontend roda em <slug>.localhost:5500 e os backends rodam no
# mesmo hostname com portas diferentes — o slug é herdado automaticamente,
# basta saber as portas. URLs são derivadas em runtime a partir de
# window.location.hostname + a porta abaixo.
VITE_CORE_PORT=5501
VITE_CHAT_PORT=5502

# Em produção, sobrescreva com URLs absolutas (descomentar). O slug do tenant
# tem que estar no hostname dessas URLs pra o backend extrair via Host header.
# VITE_CORE_URL=https://api.elora.app.br
# VITE_CHAT_URL=https://chat.elora.app.br
